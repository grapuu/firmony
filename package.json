{
  "name": "firmony",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firmony: accounting for young Slovak companies (firmony.ai)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "esbuild test/units.entry.ts --bundle --format=esm --platform=neutral --main-fields=module,main --log-level=warning --outfile=.wrangler/tmp/units-bundle.mjs && node --no-warnings test/units.test.mjs",
    "test:runtime": "esbuild src/index.tsx --bundle --format=esm --platform=neutral --main-fields=module,main --log-level=warning --outfile=.wrangler/dist/index.js && node --no-warnings test/e2e.workerd.mjs"
  },
  "dependencies": {
    "bysquare": "4.0.2",
    "fast-xml-parser": "5.11.1",
    "hono": "^4.13.12",
    "postal-mime": "2.7.6",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0",
    "xmllint-wasm": "5.3.0"
  }
}
