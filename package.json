{
  "name": "firmony",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firmony: accounting for young Slovak companies (firmony.ai)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "esbuild test/units.entry.ts --bundle --format=esm --platform=neutral --log-level=warning --outfile=.wrangler/tmp/units-bundle.mjs && node --no-warnings test/units.test.mjs",
    "test:runtime": "wrangler deploy --dry-run --outdir .wrangler/dist && node --no-warnings test/e2e.workerd.mjs"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
