{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firmony",
  "main": "src/index.tsx",
  "build": { "command": "npm run build:assets" },
  "compatibility_date": "2026-10-01",

  // The stylesheet and the fonts are served straight from ./public.
  "assets": { "directory": "./public" },

  // Everything the app keeps. The ID is the D1 database "firmony" in the owner's Cloudflare account, created on
  // 20 October 2026 in the EU jurisdiction (the privacy notice says the database is in the EU).
  "d1_databases": [{ "binding": "DB", "database_name": "firmony", "database_id": "24b965d5-d57f-4ffe-aec6-1de4e7889fee" }],

  // Email through Cloudflare's email service, from the domain once it is onboarded for sending.
  "send_email": [{ "name": "EMAIL" }],

  // Until the domain is bought the site is reachable at its workers.dev address, which tells search engines to
  // stay away (X-Robots-Tag in src/index.tsx). The custom domain comes as a route once it is in the account.
  // Settings added in the dashboard as plain text (ENABLE_BANKING_APP, the first administrator's e-mail and expiry,
  // CONTRACT_RELEASE) stay when a push to main deploys a new version; without this, every deploy would remove them.
  "keep_vars": true,

  "workers_dev": true,
  "preview_urls": false,

  // The client's documents (photos, PDFs, e-invoices), in the EU jurisdiction: the bucket "firmony-files", created in
  // the owner's account on 20 October 2026.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "firmony-files", "jurisdiction": "eu" }],

  // Every fifteen minutes: send what waits in the outbox, delete what the privacy notice says is deleted, read again
  // a document whose reading was cut off.
  "triggers": { "crons": ["*/15 * * * *"] },

  // Only what the code logs itself (error names). No record of individual requests, so no IP addresses or URLs
  // end up in logs.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
